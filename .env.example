# Public address encoded in room/controller QR codes. Include scheme and port.
# Local Wi-Fi development: http://192.168.1.100:5173
# Public deployment: https://anka.example.com
ANKA_PUBLIC_URL=

# Backend listen address; independent of the externally advertised address.
HOST=0.0.0.0
PORT=8000

# Optional local Vite HTTPS. Use a certificate trusted by the phone; never commit the private key.
# Also set ANKA_PUBLIC_URL=https://<certificate-host>:5173, then restart frontend/backend.
ANKA_DEV_TLS_CERT=
ANKA_DEV_TLS_KEY=
