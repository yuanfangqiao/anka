{
  "schema_version": 2,
  "workspace": {
    "projects_dir": ".",
    "default_project": ".",
    "run_dir": ".mosaico-runs"
  },
  "dependencies": {
    "bsp": ".deps/bsp",
    "esp_iris": ".deps/utils/ESP-Iris"
  },
  "build": { "runner": "builtin" },
  "devices": [
    {
      "id": "esp-mosaico",
      "name": "ESP-Mosaico",
      "target": "esp32s31",
      "status": "supported",
      "default": true,
      "recovery_usb_ids": [
        { "vid": "0x303a", "pid": "0x0020", "product": "ESP32-S31" }
      ]
    }
  ]
}
