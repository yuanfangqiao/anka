{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "vue": ["../../../web/node_modules/vue"]
    }
  },
  "include": ["./**/*.ts", "./**/*.d.ts", "./**/*.vue"]
}
